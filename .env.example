# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://technomiles.com

# Contact form → Zoho Mail SMTP (wired up in the connectivity step)
# Host depends on your Zoho data centre: smtp.zoho.com | smtp.zoho.eu | smtp.zoho.in | smtp.zoho.com.au
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=you@technomiles.com
# Use a Zoho app-specific password if two-factor login is on
SMTP_PASS=
CONTACT_FROM=you@technomiles.com
CONTACT_TO=info@technomiles.com
