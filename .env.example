# Public site URL (canonical links, sitemap, Open Graph). Set by the GitHub Pages workflow.
NEXT_PUBLIC_SITE_URL=https://technomiles.com

# Sub-path when hosted as a GitHub Pages project site (e.g. /Technomiles.com). Leave empty locally.
NEXT_PUBLIC_BASE_PATH=

# Optional contact-form backend that accepts a JSON POST (Formspree, Web3Forms, a Zoho Forms webhook…).
# Without it, the form opens the visitor's email app pre-filled to info@technomiles.com.
NEXT_PUBLIC_FORM_ENDPOINT=
